# Copy this file to `.env` and fill in your values. Do NOT commit the real `.env` file.
# Vite requires env variables used in client code to be prefixed with VITE_
VITE_IMGBB_KEY=your-imgbb-api-key-here
VITE_API_BASE=http://localhost:5000
# If set to "true", the frontend will POST images to the backend proxy
# at /api/uploads/imgbb instead of uploading directly to ImgBB.
VITE_USE_IMGBB_PROXY=true

# Beehiiv (newsletter) settings
# IMPORTANT: Store the Beehiiv API key and publication id on the BACKEND only.
# Do NOT place your server API key in the frontend `.env` (that would expose the secret
# in the built bundle). Instead, put these values into the backend's `.env` file:
# BEEHIIV_KEY=your-beehiiv-server-key
# BEEHIIV_PUBLICATION_ID=pub_xxx-xxx-xxxx

