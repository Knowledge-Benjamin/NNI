# Top-level gitignore for the monorepo

# Node
node_modules/
**/node_modules/

# Build outputs
dist/
build/
/.vite

# Env files (do NOT commit secrets)
.env
.env.*
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Misc
*.local
